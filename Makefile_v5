CC ?= cc
CFLAGS ?= -O3 -Wall -Wextra -std=c11 -Iinclude

EXCLUDED := src/main.c src/cjang_bridge_cli.c
LIB_SRCS := $(filter-out $(EXCLUDED),$(wildcard src/*.c))
LIB_OBJS := $(LIB_SRCS:src/%.c=build/%.o)
LIB_A := build/libcj.a

.PHONY: all test clean

all: $(LIB_A) build/cjangd build/cjang_bridge_cli

build/%.o: src/%.c
	@mkdir -p build
	$(CC) $(CFLAGS) -c -o $@ $<

$(LIB_A): $(LIB_OBJS)
	@mkdir -p build
	ar rcs $@ $^

build/cjangd: $(LIB_A) build/main.o
	$(CC) $(CFLAGS) -o $@ build/main.o $(LIB_A)

build/cjang_bridge_cli: $(LIB_A) build/cjang_bridge_cli.o
	$(CC) $(CFLAGS) -o $@ build/cjang_bridge_cli.o $(LIB_A)

build/test_ringbuf_v1: $(LIB_A) tests/test_ringbuf_v1.c
	$(CC) $(CFLAGS) -o $@ tests/test_ringbuf_v1.c $(LIB_A)

build/test_log_v1: $(LIB_A) tests/test_log_v1.c
	$(CC) $(CFLAGS) -o $@ tests/test_log_v1.c $(LIB_A)

build/test_static_v1: $(LIB_A) tests/test_static_v1.c
	$(CC) $(CFLAGS) -o $@ tests/test_static_v1.c $(LIB_A)

build/test_kv_v1: $(LIB_A) tests/test_kv_v1.c
	$(CC) $(CFLAGS) -o $@ tests/test_kv_v1.c $(LIB_A)

build/test_http_static_v1: $(LIB_A) tests/test_http_static_v1.c
	$(CC) $(CFLAGS) -o $@ tests/test_http_static_v1.c $(LIB_A)

test: build/test_ringbuf_v1 build/test_log_v1 build/test_static_v1 build/test_kv_v1 build/test_http_static_v1
	./build/test_ringbuf_v1
	./build/test_log_v1
	./build/test_static_v1
	./build/test_kv_v1
	./build/test_http_static_v1

clean:
	rm -rf build
