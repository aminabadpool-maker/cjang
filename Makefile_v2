CC ?= gcc
CFLAGS ?= -O3 -Wall -Wextra -std=c11 -Iinclude

EXCLUDED := src/main.c src/cjang_bridge_cli.c
LIB_SRCS := $(filter-out $(EXCLUDED),$(wildcard src/*.c))
LIB_OBJS := $(LIB_SRCS:src/%.c=build/%.o)

.PHONY: all clean

all: build/cjangd build/cjang_bridge_cli

build/%.o: src/%.c
	@mkdir -p build
	$(CC) $(CFLAGS) -c -o $@ $<

build/cjangd: $(LIB_OBJS) build/main.o
	$(CC) $(CFLAGS) -o $@ $^

build/cjang_bridge_cli: $(LIB_OBJS) build/cjang_bridge_cli.o
	$(CC) $(CFLAGS) -o $@ $^

clean:
	rm -rf build
